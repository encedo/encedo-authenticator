<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing this app keeps leaves the phone. The storage is encrypted with a key
     that never leaves this phone's secure hardware, so a copy restored elsewhere
     could not be read anyway; excluding it keeps the useless copy from being made
     and keeps a restored install from looking like a broken one. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
