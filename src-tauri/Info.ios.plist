<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The scanner reads the Manager's pairing code; nothing else uses the camera. -->
	<key>NSCameraUsageDescription</key>
	<string>Encedo HEM Authenticator reads the pairing code your Encedo Manager shows.</string>
	<!-- The app lock; the device passcode is the fallback. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Encedo HEM Authenticator asks who you are before it answers a module.</string>
	<!-- One column of decisions: portrait only, like the Android build. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- encedo-auth://pair?qr=…: the Manager open in a browser on this phone hands its pairing code over. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>encedo-auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>encedo-auth</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
